# Copy this file to .env before the first `docker compose up -d`.

# Grafana's port on your machine. Change it if 3300 is already in use.
GRAFANA_PORT=3300

# Where images are pulled from. Change it only if the facilitator gives you
# another registry.
IMAGE_REGISTRY=docker.io

# Exact image versions. Every attendee runs the same ones; don't change them.
GRAFANA_TAG=12.2.1
LOKI_TAG=3.5.7
ALLOY_TAG=v1.11.3
PROMETHEUS_TAG=v3.7.3
GO_TAG=1.24.9-alpine
